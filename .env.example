# =============================================================================
# MINIO CONFIGURATION
# =============================================================================

# Domain for S3 API (e.g., s3.haex.space)
DOMAIN=s3.haex.space

# MinIO Root Credentials (Admin)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your-secure-password-here

# Traefik Configuration
TRAEFIK_NETWORK=proxy
TRAEFIK_ENDPOINT_HTTP_NAME=web
TRAEFIK_ENDPOINT_HTTPS_NAME=web_secure
TRAEFIK_LETS_ENCRYPT_RESOLVER=http_resolver
